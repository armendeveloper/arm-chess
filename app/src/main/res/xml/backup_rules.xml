<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower: exclude everything from backup (design §9.2, decision H-5).
    android:allowBackup="false" already turns backup off there; this keeps the intent explicit.
    Android 12+ uses data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
